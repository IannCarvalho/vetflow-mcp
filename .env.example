# Copie para .env e preencha. NUNCA commite o .env real.
VETFLOW_BASE_URL=http://localhost:8080

# Autenticação: escolha UM dos dois modos.
# 1) Login (Claude Desktop, dev local): o MCP faz POST /auth/login com estas.
VETFLOW_EMAIL=seu-email@exemplo.com
VETFLOW_PASSWORD=sua-senha
# 2) Pass-through: um JWT já emitido pelo backend, usado como está (sem login
#    nem renovação; quando expira, as tools respondem "Sessão expirada").
#    Com ele definido, email/senha são ignorados.
# VETFLOW_TOKEN=

# Opcional (segundos, default 15):
VETFLOW_TIMEOUT_S=15
# Fase 2: habilita as tools de ESCRITA (criar/atualizar). Default: desligado.
VETFLOW_ENABLE_WRITES=false
